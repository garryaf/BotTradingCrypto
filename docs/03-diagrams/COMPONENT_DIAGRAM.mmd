    %% Hubungan Komponen
    ROUTER_API --> AUTH_MIDDLEWARE
    AUTH_MIDDLEWARE --> REPO_PORTFOLIO
    AUTH_MIDDLEWARE --> REPO_SIGNALS
    TG_CONTROLLER --> CIRCUIT_BREAKER

    BYBIT_CONNECTOR --> DEDUPLICATOR
