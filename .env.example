# ==============================================================================
# AUTO-TRADE-AA: Environment Configuration Template (.env.example)
# Salin file ini menjadi `.env` sebelum menjalankan container Docker
# ==============================================================================

# --- System & Security ---
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_API_SECRET=change_me_to_a_random_32_char_secret_min_len
LIVE_TRADING_ENABLED=false
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL 16) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autotrade_db
POSTGRES_USER=autotrade_app
POSTGRES_PASSWORD=change_me_to_a_strong_password
DATABASE_URL=postgresql+asyncpg://autotrade_app:change_me_to_a_strong_password@postgres:5432/autotrade_db

# --- Optional Redis Cache (Default: Disabled) ---
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379

# --- AI Model Gateway (Dual Provider, both OpenAI-compatible /chat/completions) ---
# Primary Gateway
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-5.5
# Fallback Gateway — isi NINEROUTE_BASE_URL sesuai endpoint provider 9Route Anda
NINEROUTE_BASE_URL=
NINEROUTE_API_KEY=your_9route_api_key_here
NINEROUTE_DEFAULT_MODEL=google/gemini-flash-1.5

# --- Market Data: Solana Blockchain ---
# Kosongkan HELIUS_API_KEY untuk otomatis fallback ke Public RPC (Q-04).
HELIUS_API_KEY=
SOLANA_COMMITMENT=confirmed

# --- Market Data: Binance Spot (Primary Active CEX) ---
BINANCE_API_KEY=your_binance_public_api_key_here
BINANCE_API_SECRET=your_binance_secret_key_here
BINANCE_TESTNET=true

# --- Market Data: Bybit Spot (Secondary CEX - Future Releases Roadmap) ---
# BYBIT_API_KEY=your_bybit_public_api_key_here
# BYBIT_API_SECRET=your_bybit_secret_key_here
# BYBIT_TESTNET=true

# --- Risk & Portfolio Parameters ---
INITIAL_PAPER_CAPITAL_USD=10000.00
MAX_RISK_PER_TRADE_PCT=0.005
DAILY_LOSS_LIMIT_PCT=0.02
MAX_DRAWDOWN_LIMIT_PCT=0.08
MAX_SPREAD_PCT=0.0008
DATA_FRESHNESS_MAX_AGE_SEC=30

# --- Auth (per-user accounts, one Binance API key per user) ---
# Generate: JWT_SECRET_KEY via `openssl rand -hex 32`, FIELD_ENCRYPTION_KEY via
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
JWT_SECRET_KEY=change_me_to_a_random_hex_secret
FIELD_ENCRYPTION_KEY=change_me_to_a_fernet_generated_key

# --- Rust Risk Gate Engine (optional, fail-closed) ---
# Kosong = hanya Risk Gate Python in-process. Isi http://engine:8080 dan jalankan
# `docker compose --profile engine up` untuk mewajibkan persetujuan engine Rust juga.
ENGINE_URL=
ENGINE_TIMEOUT_MS=10

# --- Telegram Bot & Emergency Control ---
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_ALLOWED_USER_ID=987654321
TELEGRAM_ALLOWED_CHAT_ID=987654321

# --- Web Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
